{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DrawForge provisional JSON protocol v1",
  "description": "Provider-neutral Phase 0 interchange contract; compatibility is not promised before the Phase 1 gate.",
  "oneOf": [
    {
      "$ref": "#/$defs/request_frame"
    },
    {
      "$ref": "#/$defs/success_frame"
    },
    {
      "$ref": "#/$defs/error_frame"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "bounded_text": {
      "type": "string",
      "maxLength": 65536
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "coordinate": {
      "type": "number",
      "minimum": -1048576.0,
      "maximum": 1048576.0
    },
    "nonnegative_coordinate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1048576.0
    },
    "positive_coordinate": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1048576.0
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{8}$"
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/coordinate"
        },
        "y": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "maxProperties": 64
    },
    "transform": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/coordinate"
        },
        "b": {
          "$ref": "#/$defs/coordinate"
        },
        "c": {
          "$ref": "#/$defs/coordinate"
        },
        "d": {
          "$ref": "#/$defs/coordinate"
        },
        "e": {
          "$ref": "#/$defs/coordinate"
        },
        "f": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "a",
        "b",
        "c",
        "d",
        "e",
        "f"
      ],
      "additionalProperties": false,
      "maxProperties": 64
    },
    "canvas_extent": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
